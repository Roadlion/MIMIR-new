# MIMIR Environment Configuration

# Database Settings (Local or Remote PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pantheon_db
DB_USER=postgres
DB_PASSWORD=
MIMIR_SCHEMA=yggdrasil

# Operational Mode (standalone / server)
MIMIR_MODE=standalone

# Primary LLM (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Fallback LLMs (Free Tiers Available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Search & News APIs (For Oracle and News Scrapers)
TAVILY_API_KEY=
NEWSAPI_KEY=
GNEWS_API_KEY=

# Discord Webhook Alerts (Push Notifications)
DISCORD_WEBHOOK_URL=
DISCORD_MENTION_ROLE_ID=
